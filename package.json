{
  "name": "situ",
  "private": true,
  "version": "0.1.0",
  "description": "SITU — red social informativa con mapa (monorepo)",
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev:api": "dotnet watch --project apps/backend/src/Situ.Api",
    "dev:web": "pnpm --filter @situ/web dev",
    "dev:landing": "pnpm --filter @situ/landing dev",
    "dev:admin": "pnpm --filter @situ/admin dev",
    "dev:support": "pnpm --filter @situ/support dev",
    "dev:mobile": "pnpm --filter @situ/mobile start",
    "api:build": "dotnet build apps/backend/Situ.slnx",
    "api:test": "dotnet test apps/backend/Situ.slnx",
    "legal:check": "pnpm --filter @situ/landing legal:check",
    "openapi": "pnpm --filter @situ/shared openapi",
    "openapi:check": "pnpm --filter @situ/shared openapi:check",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,md,mdx,yml,yaml,css}\""
  },
  "devDependencies": {
    "prettier": "^3.6.0",
    "turbo": "^2.5.0",
    "typescript": "^5.9.0"
  }
}
