# API que consume el servidor de Next y el hub de SignalR del navegador.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5080

# Clave de navegador de Google Maps JavaScript API.
# No uses la de Android ni la de iOS. Déjala vacía en el ejemplo.
# Restricción: HTTP referrers, por ejemplo http://localhost:3002/* y https://tudominio/*
NEXT_PUBLIC_GOOGLE_MAPS_KEY=
