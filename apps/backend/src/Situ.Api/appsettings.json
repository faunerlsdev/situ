{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.AspNetCore.SignalR": "Warning",
      "Microsoft.AspNetCore.Http.Connections": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Jwt": {
    "Issuer": "situ-api",
    "Audience": "situ-clients",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 30
  },
  "Network": {
    "KnownProxies": []
  },
  "MapRealtime": {
    "CellDegrees": 0.05,
    "MaxCells": 16,
    "CoalesceIntervalMilliseconds": 1000,
    "MaxSubscribeCallsPerMinute": 20
  }
}
