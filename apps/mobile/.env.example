# Copia este archivo a apps/mobile/.env. No subas las keys.
# Una key por plataforma. Restríngelas a com.somossitu.app (Android: paquete + SHA-1, iOS: bundle ID).
# Cómo crearlas: README, secciones "Identificadores de la app" y "Mapa".
# Sin la de iOS, el mapa usa Apple Maps. Sin la de Android, la pestaña Mapa no monta el mapa.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_ANDROID=
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY_IOS=

# Ruta local de google-services.json, fuera del repositorio. Sin valor o si el archivo no existe, Android arranca sin push.
GOOGLE_SERVICES_JSON=

# Opcional. Por defecto el cliente usa http://localhost:5080.
# En un dispositivo físico usa la IP de la máquina, por ejemplo http://192.168.1.119:5080.
EXPO_PUBLIC_API_URL=
