{
  "expo": {
    "name": "SITU",
    "slug": "situ",
    "scheme": "situ",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/situ-isotipo-naranja-claro.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1C1C",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "Y27698UG63",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSLocationWhenInUseUsageDescription": "SITU usa tu ubicación para centrar el mapa, calcular distancias y confirmar que estás cerca de un reporte.",
        "NSPhotoLibraryUsageDescription": "SITU accede a tus fotos y videos para publicarlos en un reporte.",
        "NSCameraUsageDescription": "SITU usa la cámara para tomar una foto o un video del reporte.",
        "NSMicrophoneUsageDescription": "SITU usa el micrófono si grabas un video para un reporte.",
        "NSFaceIDUsageDescription": "SITU usa Face ID para desbloquear tu sesión.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#1C1C1C",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#1C1C1C",
      "barStyle": "light-content"
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/situ-isotipo-naranja-claro.png",
        "backgroundColor": "#1C1C1C"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SITU usa Face ID para desbloquear tu sesión."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/situ-logo-vertical-naranja.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1C"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
