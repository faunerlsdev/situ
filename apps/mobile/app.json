{
  "expo": {
    "name": "SITU",
    "slug": "situ",
    "scheme": "situ",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/situ-isotipo-naranja-claro.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1C1C",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "co.situ.app",
      "appleTeamId": "Y27698UG63",
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#1C1C1C",
      "barStyle": "light-content",
      "translucent": false
    },
    "androidNavigationBar": {
      "backgroundColor": "#1C1C1C",
      "barStyle": "light-content"
    },
    "android": {
      "package": "co.situ.app",
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/situ-isotipo-naranja-claro.png",
        "backgroundColor": "#1C1C1C"
      },
      "permissions": [
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SITU usa Face ID para desbloquear tu sesión."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/situ-logo-vertical-naranja.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1C"
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
