{
  "expo": {
    "name": "SITU",
    "slug": "situ",
    "scheme": "situ",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/images/brand/situ-isotipo-naranja-claro.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#1C1C1C",
    "ios": {
      "supportsTablet": true,
      "appleTeamId": "Y27698UG63",
      "config": {
        "usesNonExemptEncryption": false
      },
      "privacyManifests": {
        "NSPrivacyTracking": false,
        "NSPrivacyCollectedDataTypes": [],
        "NSPrivacyAccessedAPITypes": [
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryUserDefaults",
            "NSPrivacyAccessedAPITypeReasons": ["CA92.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryFileTimestamp",
            "NSPrivacyAccessedAPITypeReasons": ["C617.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategoryDiskSpace",
            "NSPrivacyAccessedAPITypeReasons": ["E174.1"]
          },
          {
            "NSPrivacyAccessedAPIType": "NSPrivacyAccessedAPICategorySystemBootTime",
            "NSPrivacyAccessedAPITypeReasons": ["35F9.1"]
          }
        ]
      },
      "infoPlist": {
        "UIUserInterfaceStyle": "Dark",
        "NSLocationWhenInUseUsageDescription": "SITU usa tu ubicación mientras la app está abierta para centrar el mapa, calcular distancias y confirmar que estás cerca de un reporte. No la usamos en segundo plano.",
        "NSPhotoLibraryUsageDescription": "SITU accede a tus fotos y videos solo cuando eliges uno para publicarlo en un reporte o en tu foto de perfil.",
        "NSCameraUsageDescription": "SITU usa la cámara cuando tú tomas una foto o grabas un video para un reporte.",
        "NSMicrophoneUsageDescription": "SITU usa el micrófono solo si grabas un video para un reporte. No graba audio por su cuenta.",
        "NSFaceIDUsageDescription": "SITU usa Face ID para desbloquear tu sesión en este dispositivo.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "androidStatusBar": {
      "backgroundColor": "#1C1C1C",
      "barStyle": "light-content",
      "translucent": false
    },
    "android": {
      "predictiveBackGestureEnabled": false,
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/brand/situ-isotipo-naranja-claro.png",
        "backgroundColor": "#1C1C1C"
      },
      "permissions": [
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.USE_BIOMETRIC",
        "android.permission.USE_FINGERPRINT"
      ],
      "blockedPermissions": [
        "android.permission.ACCESS_BACKGROUND_LOCATION",
        "android.permission.ACCESS_MEDIA_LOCATION",
        "android.permission.ACTIVITY_RECOGNITION",
        "android.permission.FOREGROUND_SERVICE_LOCATION",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.READ_MEDIA_IMAGES",
        "android.permission.READ_MEDIA_VIDEO",
        "android.permission.READ_MEDIA_AUDIO",
        "android.permission.READ_MEDIA_VISUAL_USER_SELECTED",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "com.google.android.gms.permission.AD_ID"
      ]
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "SITU usa Face ID para desbloquear tu sesión en este dispositivo."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/brand/situ-logo-vertical-naranja.png",
          "resizeMode": "contain",
          "backgroundColor": "#1C1C1C"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
