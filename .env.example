# Copia este archivo a .env (nunca subas .env al repositorio).
# El backend lee su configuración de apps/backend/src/Situ.Api/appsettings*.json;
# estas variables sirven para las apps JS.

# Apps web (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:5080

# App móvil (Expo)
EXPO_PUBLIC_API_URL=http://localhost:5080
