# Única fuente de puertos y dominio. Se copia a /etc/situ/ports.env
# si ese archivo no existe. Los servicios leen /opt/situ/ports.env.
#
# Ya están en uso y no se pueden tomar:
# 22 25 80 443 465 587 993 (correo y nginx)
# 1935 18888 19997 (otro MediaMTX)
# 3000 3001 3003 3306 5000 5002 6379 11332 11333 11334
#
# SITU_POSTGRES_PORT vacío: la API entra por el socket, no por el 5432.
# Estos scripts no tocan ufw, fail2ban, swap, SSH ni paquetes del sistema.

SITU_DOMAIN_ROOT=somossitu.com

SITU_API_PORT=15080
SITU_ADMIN_PORT=15081
SITU_WEB_PORT=15082
SITU_LANDING_PORT=15083
SITU_SUPPORT_PORT=15084
SITU_RTMPS_PORT=1936
SITU_HLS_PORT=18890
SITU_MTX_API_PORT=19998
SITU_LIVE_AUTH_PORT=5099

SITU_POSTGRES_HOST=/var/run/postgresql
SITU_POSTGRES_PORT=
