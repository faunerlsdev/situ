# Se lee como shell. Los valores van entre comillas.
# LIVE_AUTH_URL apunta a la API. El secreto de ingestión no va en esta URL:
# install.sh lo añade solo en el archivo local de MediaMTX.
DOMAIN_ROOT="__DOMAIN__"
LIVE_AUTH_URL="http://127.0.0.1:15080/internal/live/authorize"
LIVE_AUTH_PORT="5099"
LIVE_INGEST_SECRET="CHANGE_ME"
LIVE_HLS_SECRET="CHANGE_ME"
HLS_CDN_SECRET="CHANGE_ME"
