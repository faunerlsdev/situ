# Copy to /etc/situ/live.env on the server. install.sh generates the secrets and does not print them.
# When the API exists, point LIVE_AUTH_URL at it and stop situ-live-auth.service.

DOMAIN_ROOT=
LIVE_AUTH_URL=http://127.0.0.1:5099/authorize
LIVE_AUTH_PORT=5099
LIVE_INGEST_SECRET=
LIVE_HLS_SECRET=
HLS_CDN_SECRET=
