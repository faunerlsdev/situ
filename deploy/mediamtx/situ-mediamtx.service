[Unit]
Description=SITU MediaMTX
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mediamtx
Group=mediamtx
WorkingDirectory=/var/lib/situ/live
ExecStart=/usr/local/bin/mediamtx /etc/mediamtx/mediamtx.yml
ExecReload=/bin/kill -HUP $MAINPID
Restart=on-failure
RestartSec=3
MemoryHigh=512M
MemoryMax=768M
CPUQuota=100%
TasksMax=256
LimitNOFILE=65535
UMask=0027
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/situ/live
ReadOnlyPaths=/etc/mediamtx
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
