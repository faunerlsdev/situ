server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name api.__DOMAIN_ROOT__;
    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    client_max_body_size 30m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy no-referrer always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/situ/acme;
        default_type text/plain;
    }

    location ~ /\. {
        deny all;
    }

    location /api/v1/auth/ {
        limit_req zone=situ_auth burst=20 nodelay;
        proxy_pass http://127.0.0.1:__SITU_API_PORT__;
        include /etc/nginx/snippets/situ-proxy.conf;
    }

    location /api/v1/admin/auth/ {
        limit_req zone=situ_auth burst=10 nodelay;
        proxy_pass http://127.0.0.1:__SITU_API_PORT__;
        include /etc/nginx/snippets/situ-proxy.conf;
    }

    location /hubs/ {
        proxy_pass http://127.0.0.1:__SITU_API_PORT__;
        proxy_read_timeout 3600s;
        include /etc/nginx/snippets/situ-proxy.conf;
    }

    location / {
        proxy_pass http://127.0.0.1:__SITU_API_PORT__;
        include /etc/nginx/snippets/situ-proxy.conf;
    }
}
