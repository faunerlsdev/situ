server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name app.__DOMAIN_ROOT__;
    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    client_max_body_size 30m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/situ/acme;
        default_type text/plain;
    }

    location = /.well-known/apple-app-site-association {
        alias /var/lib/situ/well-known/apple-app-site-association;
        default_type application/json;
    }

    location = /.well-known/assetlinks.json {
        alias /var/lib/situ/well-known/assetlinks.json;
        default_type application/json;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:__SITU_WEB_PORT__;
        include /etc/nginx/snippets/situ-proxy.conf;
    }
}
