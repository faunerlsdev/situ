# Generated by deploy/nginx/install.sh. Do not edit on the server.
map $http_upgrade $connection_upgrade {
    default upgrade;
    ''      close;
}

limit_req_zone $binary_remote_addr zone=situ_auth:10m rate=10r/s;
limit_req_status 429;

gzip on;
gzip_vary on;
gzip_proxied any;
gzip_comp_level 5;
gzip_types text/css application/javascript application/json image/svg+xml text/plain application/xml;

server {
    listen 80;
    listen [::]:80;
    server_name __DOMAIN_ROOT__ www.__DOMAIN_ROOT__ app.__DOMAIN_ROOT__ admin.__DOMAIN_ROOT__ ayuda.__DOMAIN_ROOT__ api.__DOMAIN_ROOT__;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/situ/acme;
        default_type text/plain;
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name www.__DOMAIN_ROOT__;
    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    return 301 https://__DOMAIN_ROOT__$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name __DOMAIN_ROOT__;
    ssl_certificate     __CERT_DIR__/fullchain.pem;
    ssl_certificate_key __CERT_DIR__/privkey.pem;
    client_max_body_size 2m;

    add_header Strict-Transport-Security "max-age=31536000" always;
    add_header X-Content-Type-Options nosniff always;
    add_header X-Frame-Options DENY always;
    add_header Referrer-Policy strict-origin-when-cross-origin always;
    add_header Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'" always;

    location ^~ /.well-known/acme-challenge/ {
        root /var/lib/situ/acme;
        default_type text/plain;
    }

    location ~ /\. {
        deny all;
    }

    location / {
        proxy_pass http://127.0.0.1:3003;
        include /etc/nginx/snippets/situ-proxy.conf;
    }
}

